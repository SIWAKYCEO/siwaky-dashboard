# Dashboard ordini → FastAPI locale (non usare NEXT_PUBLIC_API_URL qui)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

NEXT_PUBLIC_API_URL=https://api.siwaky.com
NEXT_PUBLIC_SITE_URL=https://siwaky.com

# Bump this when replacing `public/logo.png` so browsers/CDNs don’t reuse the old raster (`/_next/image` included).
NEXT_PUBLIC_LOGO_REVISION=6

# Optional: floating “live order” ticker (hidden in production unless set to true).
# NEXT_PUBLIC_SHOW_SOCIAL_PROOF_TICKER=true

# Pixels (web)
NEXT_PUBLIC_META_PIXEL_ID=1898036304185332
NEXT_PUBLIC_TIKTOK_PIXEL_ID=D722UD3C77UDBCCMEAQG
NEXT_PUBLIC_SNAP_PIXEL_ID=PLACEHOLDER_ADD_LATER

# Optional WhatsApp floating CTA (E.164, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=
