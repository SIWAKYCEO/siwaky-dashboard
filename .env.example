# Dashboard ordini → FastAPI locale (non usare NEXT_PUBLIC_API_URL qui)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

NEXT_PUBLIC_API_URL=https://api.siwaky.com
NEXT_PUBLIC_SITE_URL=https://siwaky.com

# Bump this when replacing `public/logo.png` so browsers/CDNs don’t reuse the old raster (`/_next/image` included).
NEXT_PUBLIC_LOGO_REVISION=6

# Optional: floating “live order” ticker (hidden in production unless set to true).
# NEXT_PUBLIC_SHOW_SOCIAL_PROOF_TICKER=true

# Pixels (web)
NEXT_PUBLIC_META_PIXEL_ID=1898036304185332
NEXT_PUBLIC_TIKTOK_PIXEL_ID=D722UD3C77UDBCCMEAQG
NEXT_PUBLIC_SNAP_PIXEL_ID=PLACEHOLDER_ADD_LATER

# Optional WhatsApp floating CTA (E.164, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Dashboard auth (Next.js `/dashboard`) ---
# HS256 signing secret — use >= 32 random bytes in production.
DASHBOARD_AUTH_SECRET=replace-with-long-random-secret-at-least-32-chars
#
# Allowed operators as JSON array. Prefer bcrypt hashes (`passwordHash`).
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('your-password',12))"
# Example:
# DASHBOARD_USERS_JSON=[{"email":"ops@example.com","passwordHash":"$2b$12$...","role":"admin"}]
DASHBOARD_USERS_JSON=[]
#
# Server-side orders proxy → FastAPI `/orders` (recommended for prod so the browser never hits FastAPI).
# Falls back to NEXT_PUBLIC_API_BASE_URL, then http://127.0.0.1:8000.
# DASHBOARD_ORDERS_API_BASE_URL=http://127.0.0.1:8000
#
# Never enable in production — plaintext `password` fields in JSON only when true (also accepts `1` / `yes`).
# Put `frontend/.env.local` next to `frontend/package.json` — Next loads it automatically for server routes (`next dev` cwd must be `frontend/`).
# Keep JSON on one line; if your shell/parser strips quotes, wrap the whole JSON in single quotes:
# DASHBOARD_USERS_JSON='[{"email":"you@company.com","password":"your-dev-password"}]'
# DASHBOARD_AUTH_ALLOW_PLAINTEXT_PASSWORDS=true
